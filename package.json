{
  "name": "rupyaa-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx expo start --clear",
    "prebuild-android": "npx expo prebuild -p android --clean",
    "prebuild-ios": "npx expo prebuild -p ios --clean",
    "build-prod-android": "cross-env APP_PLATFORM=android eas build --profile production --platform android --clear-cache",
    "build-dev-android": "eas build --profile development --platform android --clear-cache",
    "build-prod-ios": "cross-env APP_PLATFORM=ios eas build --profile production --platform ios",
    "build-dev-ios": "eas build --profile development --platform ios",
    "build-local-android": "eas build --profile local --platform android --clear-cache",
    "build-local-ios": "eas build --profile simulator --platform ios",
    "build-preview-android": "eas build --profile preview --platform android --clear-cache",
    "build-testflight-ios": "eas build --profile testflight --platform ios",
    "build-preview-ios": "eas build --profile preview --platform ios",
    "submit-dev-android": "eas submit --profile development --platform android",
    "submit-prod-android": "eas submit --profile production --platform android",
    "submit-dev-ios": "eas submit --profile development --platform ios",
    "submit-prod-ios": "eas submit --profile production --platform ios",
    "verify:ota-env": "node scripts/verify-ota-env.js --all",
    "ota-preview": "node scripts/verify-ota-env.js --file .env.preview --expect-app-env development && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.preview -o -- node updateversion.js && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.preview -o -- eas update --channel preview",
    "ota-development": "node scripts/verify-ota-env.js --file .env.preview --expect-app-env development && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.preview -o -- node updateversion.js && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.preview -o -- eas update --channel development",
    "ota-production": "node scripts/verify-ota-env.js --file .env.production --expect-app-env production && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.production -o -- node updateversion.js && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.production -o -- eas update --channel production",
    "ota-development-android": "node scripts/verify-ota-env.js --file .env.preview --expect-app-env development && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.preview -o -- node updateversion.js && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.preview -o -- eas update --channel development --platform android",
    "ota-production-android": "node scripts/verify-ota-env.js --file .env.production --expect-app-env production && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.production -o -- node updateversion.js && cross-env EXPO_NO_DOTENV=1 dotenv -e .env.production -o -- eas update --channel production --platform android",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "deeplink:android": "adb shell am start -a android.intent.action.VIEW -d \"rupyaa://emi-calculator\" com.rupyaa.loan",
    "deeplink:android:https": "adb shell am start -a android.intent.action.VIEW -d \"https://rupyaa.com/emi-calculator\" com.rupyaa.loan"
  },
  "dependencies": {
    "@cashfreepayments/react-native-digilocker": "^0.1.4",
    "@config-plugins/react-native-adjust": "^12.0.0",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@hugeicons/core-free-icons": "^1.0.0",
    "@hugeicons/react-native": "^1.0.11",
    "@lucide/lab": "^0.1.2",
    "@noble/ciphers": "^2.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/crashlytics": "^23.8.6",
    "@react-native-firebase/in-app-messaging": "^23.8.6",
    "@react-native-firebase/installations": "^23.8.6",
    "@react-native-firebase/messaging": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.90.20",
    "cashfree-pg-api-contract": "^2.0.9",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.9",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-phone-number-hint": "^0.4.1",
    "expo-router": "~6.0.24",
    "expo-sms": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "freerasp-react-native": "^4.5.2",
    "i18next": "^26.3.2",
    "lottie-react-native": "~7.3.1",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-adjust": "^5.5.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-cashfree-pg-sdk": "^2.4.0",
    "react-native-collect-data": "file:native_modules/react-native-collect-data-0.1.7.tgz",
    "react-native-device-info": "^15.0.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-sms-android": "^2.1.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-network-logger": "^2.0.1",
    "react-native-play-install-referrer": "^1.1.9",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-ssl-public-key-pinning": "^1.2.6",
    "react-native-step-indicator": "^1.0.3",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-cashfree-pg-sdk",
        "cashfree-pg-api-contract"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-cashfree-pg-sdk",
          "react-native-collect-data",
          "react-native-keyboard-aware-scroll-view",
          "react-native-step-indicator"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}
