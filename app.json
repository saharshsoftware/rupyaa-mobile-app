{
  "expo": {
    "name": "Rupyaa",
    "slug": "rupyaa-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rupyaa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rupyaa.loan",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "FirebaseInAppMessagingDisplayEnabled": true,
        "NSCameraUsageDescription": "Rupyaa needs camera access to capture your selfie and scan documents for identity verification.",
        "NSLocationWhenInUseUsageDescription": "Rupyaa uses your location to verify serviceability and confirm your address during the KYC process.",
        "NSContactsUsageDescription": "Rupyaa needs access to your device contacts so you can invite friends.",
        "NSPhotoLibraryUsageDescription": "Rupyaa needs access to your photo library so you can upload documents for your loan application.",
        "NSUserTrackingUsageDescription": "We use this identifier to show you personalised offers and to measure the effectiveness of our ads.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork"
          },
          {
            "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork"
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.520032386050-ksc98gssjndoifj6vmu70j5fcijiv7n1"
            ]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "freerasp-react-native/app.plugin.js",
        {
          "android": {
            "minSdkVersion": "24"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Rupyaa needs access to your device contacts so you can invite friends."
        }
      ],
      "expo-tracking-transparency"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "otaUpdateNumberDev": "8",
      "otaUpdateNumberProd": "2",
      "versionDev": "1.0.2",
      "versionProd": "1.0.3",
      "versionProdIos": "1.0.0",
      "isDevelopment": true,
      "otaUpdateNumber": "1",
      "environment": "production",
      "disableCrashlytics": false,
      "router": {},
      "version": "1.0.38",
      "eas": {
        "projectId": "47dfc90e-0f7d-40af-a562-951aca9e89d8"
      }
    },
    "android": {
      "package": "com.rupyaa.loan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "android.permission.DETECT_SCREEN_RECORDING",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.providers.gsf.permission.READ_GSERVICES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "rupyaa"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "owner": "omnistack-innovation",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47dfc90e-0f7d-40af-a562-951aca9e89d8"
    }
  }
}
